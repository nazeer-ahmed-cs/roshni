# Supabase credentials (get these from Supabase Dashboard → Settings → API)
# Use the anon key OR the newer publishable key — either works client-side.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Admin key for `npm run seed` only — the anon/publishable role can't write the
# curated `areas` table. Never put this in client-facing env (browser bundles).
# Prefer the new format; the legacy service_role JWT also works.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# Web Push (VAPID) keys — generate with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is shipped to the browser for the PushManager
# subscribe() call. VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY are server-side only and
# are used by the notify-power-back Edge Function (see README "Push notifications").
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PUBLIC_KEY=your-vapid-public-key
# VAPID_PRIVATE_KEY=your-vapid-private-key
